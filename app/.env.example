# Local, non-committed env for the Conviction frontend.
# Copy to .env.local and fill in. Every NEXT_PUBLIC_* value is exposed to the
# browser by design — never put a secret behind that prefix.

# MagicBlock devnet RPC. Routes to both the base layer and the ER, so one
# endpoint serves both connections.
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.magicblock.app/devnet

# Router used by lib/magicblock.ts to resolve an account's ER endpoint.
NEXT_PUBLIC_ROUTER_ENDPOINT=https://devnet-router.magicblock.app/

# Wallet-adapter network. Must stay devnet — the program is only deployed there.
NEXT_PUBLIC_NETWORK=devnet

# Birdeye price feed. Only used by the deployed build; the demo runs on mock
# prices because they're more dramatic and controllable (DESIGN.md §11).
NEXT_PUBLIC_BIRDEYE_API_KEY=

# Phase C (Supabase realtime ticker + Helius webhooks) — unused in Phase B.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# HELIUS_WEBHOOK_SECRET=
